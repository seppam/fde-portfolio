# Copy to .env and fill in. Never commit .env.
GEMINI_API_KEY=
GROQ_API_KEY=
# Optional overrides
GEMINI_MODELS=gemini-3.5-flash-lite,gemini-3.8-flash,gemini-flash-latest
GROQ_MODEL=openai/gpt-oss-120b
DATABASE_URL=postgresql+psycopg://po:po@localhost:5434/po_agent
# ERP adapter: mock | odoo
ERP_ADAPTER=mock
ODOO_URL=http://localhost:8069
ODOO_DB=mspdemo
ODOO_API_KEY=
MAILPIT_API=http://localhost:8026
